#!/bin/bash
# {{ ansible_managed }}
#
# Backs up the panel database and every config that cannot be regenerated:
# panel config and secrets, tunnel configs and keys, TLS certificates.
# Keeps the last {{ kaskad_backup_keep_days }} days and writes one archive.
set -euo pipefail
umask 077

DEST="{{ kaskad_backup_dir }}"
KEEP="{{ kaskad_backup_keep_days }}"
STAMP="$(date +%Y%m%d-%H%M%S)"
ARCHIVE="$DEST/kaskad-$STAMP.tar.gz"
WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

mkdir -p "$DEST"

# sqlite3 .backup under a running panel: the API takes a consistent snapshot
# even while the panel writes, and the copy is verified before it is packed.
/opt/kaskad/venv/bin/python - "$WORK/panel.db" <<'PY'
import sqlite3
import sys

src = sqlite3.connect("/var/lib/kaskad/panel.db", timeout=30)
dst = sqlite3.connect(sys.argv[1])
with dst:
    src.backup(dst)
dst.close()
src.close()

check = sqlite3.connect(sys.argv[1])
result = check.execute("PRAGMA integrity_check").fetchone()[0]
check.close()
if result != "ok":
    raise SystemExit(f"panel.db backup is not consistent: {result}")
PY

args=(-C "$WORK" panel.db)
for dir in /etc/kaskad /etc/amnezia/amneziawg /etc/letsencrypt; do
    if [ -e "$dir" ]; then
        args+=(-C / "${dir#/}")
    fi
done
tar -czf "$ARCHIVE" "${args[@]}"
chmod 0600 "$ARCHIVE"

find "$DEST" -maxdepth 1 -type f -name 'kaskad-*.tar.gz' \
    -mtime "+$KEEP" -delete

echo "backup: $ARCHIVE ($(stat -c %s "$ARCHIVE") bytes)"
